# Copy this file to .env and adjust as needed. Never commit your real .env.

# --- Connection ---------------------------------------------------------
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
TALLY_SCHEME=http
TALLY_TIMEOUT_SECONDS=30
TALLY_CONNECT_TIMEOUT_SECONDS=5

# --- Default company ------------------------------------------------------
# Leave unset to require an explicit `company` argument on every tool call.
# TALLY_DEFAULT_COMPANY=My Company Pvt Ltd

# --- Safety ---------------------------------------------------------------
# Always true in this release; no write operations are implemented yet.
TALLY_READ_ONLY=true

# --- Limits (defence in depth) ---------------------------------------------
TALLY_MAX_RESPONSE_BYTES=26214400
TALLY_MAX_REQUEST_BYTES=1048576
TALLY_DEFAULT_VOUCHER_LIMIT=100

# --- Logging ------------------------------------------------------------
TALLY_LOG_LEVEL=INFO
# TALLY_LOG_DIR=./logs
TALLY_LOG_JSON=false

# --- Debug (leave disabled unless troubleshooting) --------------------------
TALLY_EXPOSE_RAW_XML_TOOL=false
